# Local UI and persistence demo, without Shopify credentials:
# pnpm install
# pnpm run dev:demo
# http://127.0.0.1:3000/app
# Sidekick itself runs in Shopify Admin and requires the Shopify setup below.
# One Node server hosts the UI and APIs. SQLite holds dummy company data,
# requests and Shopify sessions; no separate ERP or database service is needed.
# A production-mode local demo is also available:
# pnpm run build
# pnpm run start:demo

# For an installed Shopify app, copy this file to .env and fill these values.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SHOPIFY_API_VERSION=2026-10
# No Shopify data scopes are needed: this sample reads its own dummy data.
SCOPES=
PORT=3000
DATABASE_PATH=./data/company.sqlite

# Configure the same client ID and HTTPS URL in shopify.app.toml.
# In Dev Dashboard, enable custom distribution and install on your dev store.
# Deploy the extensions from this machine with: pnpm run shopify:deploy
# Deploy the server separately. Its normal start command is: pnpm run start
# The Render blueprint includes a persistent disk for this one server.

# Use /var/data/company.sqlite when attaching a Render persistent disk.
# DEMO_MODE is explicitly local-only and is never enabled by Render config.
